# Copie para `.env.local` e preencha com os valores de
# Supabase → Settings → API. O mesmo par vai nas variáveis de ambiente da Vercel.
#
# A chave anon é pública por natureza (vai no bundle do navegador); quem protege
# o dado é a RLS no banco, não o segredo da chave.
#
# A `service_role` NUNCA entra aqui nem em qualquer arquivo do projeto: ela
# ignora todas as regras de acesso.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
